{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/.vscode": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/node_modules": true,
    "venv": true,
    "*.sublime-*": true,
    "env*": true,
    ".cache": true,
    "**/.next": true,
    "**/.retool_types/**": true,
    "retool.config.json": true,
    "**/*tsconfig.json": true
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "oxc.enable": false,
  "oxc.enable.oxlint": true,
  "typescript.native-preview.tsdk": "node_modules\\@typescript\\native-preview"
}
